rules_version = '2';
/* Fiches PDF, vidéos de cours et images : lecture publique,
   écriture réservée à la professeure (rôle admin vérifié dans Firestore).
   NB : Cloud Storage nécessite le plan Blaze — la plateforme fonctionne
   sans (liens Google Drive / YouTube), voir FIXES.md. */
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
             && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /lessons/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
                     && request.resource.size < 50 * 1024 * 1024
                     && request.resource.contentType.matches('application/pdf|video/.*|image/.*');
    }
    match /avatars/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                     && request.resource.size < 2 * 1024 * 1024;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
